# Radar environment. Copy to `.env` (gitignored) and fill in what you need.
# Local demo mode (`make dev`) needs NONE of these: it uses SQLite + the fake LLM.

# --- Database -------------------------------------------------------------------------------
# Default: local SQLite in data/radar.db. Optional (untested in production): a Postgres URL,
# e.g. postgresql://USER:PASSWORD@HOST:5432/postgres (see docs/RUNNING.md). Port 6543
# (transaction pooler) is handled. Leave commented to use the default.
# RADAR_DATABASE_URL=sqlite:///data/radar.db

# --- LLM ------------------------------------------------------------------------------------
# Provider for scoring: groq (free tier) | anthropic | fake (offline, deterministic, for demo/tests)
RADAR_LLM_PROVIDER=groq
# Model used to score postings (fast and cheap).
RADAR_SCORING_MODEL=openai/gpt-oss-20b
# Provider for application packs and outreach drafts; commented out = same as RADAR_LLM_PROVIDER.
# To write drafts with Anthropic: RADAR_DRAFT_PROVIDER=anthropic, RADAR_DRAFT_MODEL=claude-sonnet-5-5
# and ANTHROPIC_API_KEY.
# RADAR_DRAFT_PROVIDER=anthropic
# Model used to write packs and drafts (larger, better writing).
RADAR_DRAFT_MODEL=openai/gpt-oss-120b
# Second LLM call after drafting that checks every claim against the fact bank (true/false).
# RADAR_VERIFY_DRAFTS=true
# Fact check runs on the scoring provider with its own model (Groq limits are per model)
# RADAR_VERIFY_MODEL=openai/gpt-oss-20b
# Fact bank for drafts; unset = config/facts.yaml, then config/facts.example.yaml.
# RADAR_FACTS_PATH=
# Secrets: never commit real values.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Contact search (public profiles, "Cerca contatti") ----------------------------------------
# Groq built-in browser search on a GPT-OSS model (groq/compound was decommissioned 2026-09-21).
# Hard caps, enforced before every call: estimated spend per UTC month (EUR) and calls per day.
# RADAR_CONTACTS_MODEL=openai/gpt-oss-20b
# RADAR_CONTACTS_MONTHLY_CAP_EUR=5
# RADAR_CONTACTS_DAILY_CALL_CAP=10
# Alta postings searched by the daily run (with a pack and no contacts yet).
# RADAR_CONTACTS_DAILY_POSTINGS=5
# RADAR_CONTACTS_PROVIDER=fake   # offline fictional results (default when RADAR_LLM_PROVIDER=fake)

# --- Collection -----------------------------------------------------------------------------
# Honest user agent sent to job boards (identify the tool and a contact URL).
RADAR_USER_AGENT=speculor-radar/0.1 (personal job-search tool; +https://github.com/DanieleGiovanardi2408/speculor)
# How long fetched pages/API responses are cached on disk (hours).
RADAR_HTTP_CACHE_TTL_HOURS=12

# --- Email alerts (optional, read-only IMAP) -------------------------------------------------
# Reads ONE folder/label ("radar") that holds LinkedIn / JobTeaser job-alert emails (a Gmail
# filter or an Outlook rule files them there). Radar opens it read-only (EXAMINE, BODY.PEEK) and
# never marks, moves, flags or deletes messages; other senders are ignored and email content is
# never logged. Setup for Outlook and Gmail: docs/RUNNING.md, section "Email alerts (IMAP)".
# Your mailbox address. Enables the source.
RADAR_IMAP_USER=
# Default from the address: outlook.office365.com (Outlook/Hotmail/Live) or imap.gmail.com.
# RADAR_IMAP_HOST=
# IMAP over SSL port (default 993).
# RADAR_IMAP_PORT=993
# auto (default: oauth2 for outlook/hotmail/live/msn addresses, password otherwise) | password | oauth2
# RADAR_IMAP_AUTH=auto
# Password mode (Gmail): an app password, never your main one. Better: leave it empty and run
# `uv run radar imap set-password` (stored in the macOS keychain).
RADAR_IMAP_PASSWORD=
# OAuth2 mode (Outlook.com): Application (client) ID of YOUR Entra app registration (not a
# secret). Then run `uv run radar imap login` once; tokens are kept in the macOS keychain only.
# RADAR_IMAP_OAUTH_CLIENT_ID=
# RADAR_IMAP_OAUTH_TENANT=consumers
# Folder / label to read. Default: radar.
# RADAR_IMAP_FOLDER=radar
# How many days back to look for alert emails (default 14).
# RADAR_IMAP_SINCE_DAYS=14

# --- JobTeaser (optional, local Mac only, never CI) ------------------------------------------
# Dedicated Chromium profile that holds YOUR JobTeaser (Luiss) session, created by
# `make jobteaser-login`. Keep it outside the repo. Source "jobteaser" is enabled only if it exists.
# RADAR_JOBTEASER_PROFILE=~/Library/Application Support/speculor/jobteaser-profile

# --- Local sending (`radar send`, never in CI) ----------------------------------------------
# Path or name of the linkedin-cli binary (mayai-linkedin-cli).
RADAR_LINKEDIN_BIN=linkedin

# --- API ------------------------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
RADAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional (self-hosting only; keep false locally): require a Supabase access token for every
# route except /api/health. See docs/RUNNING.md.
RADAR_AUTH_REQUIRED=false
# The single email address allowed to use the app when auth is required.
RADAR_ALLOWED_EMAIL=
# Supabase project URL: tokens are verified with its JWKS (ES256 / RS256).
# SUPABASE_URL=https://<project>.supabase.co
# Legacy HS256 tokens only: the Supabase project JWT secret. Secret.
SUPABASE_JWT_SECRET=

# --- Frontend (Vite; read at build time, must start with VITE_) ------------------------------
# API base URL; empty = same origin (the Vite dev server proxies /api to localhost:8000).
VITE_API_BASE=
