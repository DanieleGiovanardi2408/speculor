# Radar environment. Copy to `.env` (gitignored) and fill in what you need.
# Local demo mode (`make dev`) needs NONE of these: it uses SQLite + the fake LLM.

# --- Database -------------------------------------------------------------------------------
# Default: local SQLite in data/radar.db. Later: a Supabase Postgres URL
# (postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres). Leave commented to use the default.
# RADAR_DATABASE_URL=sqlite:///data/radar.db

# --- LLM ------------------------------------------------------------------------------------
# Provider for scoring: groq (free tier) | anthropic | fake (offline, deterministic, for demo/tests)
RADAR_LLM_PROVIDER=groq
# Model used to score postings (fast and cheap).
RADAR_SCORING_MODEL=openai/gpt-oss-20b
# Provider for application packs and outreach drafts; commented out = same as RADAR_LLM_PROVIDER.
# RADAR_DRAFT_PROVIDER=anthropic
# Model used to write packs and drafts (larger, better writing).
RADAR_DRAFT_MODEL=openai/gpt-oss-120b
# Secrets: never commit real values.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Collection -----------------------------------------------------------------------------
# Honest user agent sent to job boards (identify the tool and a contact URL).
RADAR_USER_AGENT=speculor-radar/0.1 (personal job-search tool; +https://github.com/DanieleGiovanardi2408/speculor)
# How long fetched pages/API responses are cached on disk (hours).
RADAR_HTTP_CACHE_TTL_HOURS=12

# --- Local sending (`radar send`, never in CI) ----------------------------------------------
# Path or name of the linkedin-cli binary (mayai-linkedin-cli).
RADAR_LINKEDIN_BIN=linkedin

# --- API ------------------------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
RADAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Cloud only: require a Supabase login for every route except /api/health.
RADAR_AUTH_REQUIRED=false
# The single email address allowed to use the app when auth is required.
RADAR_ALLOWED_EMAIL=
# Supabase project JWT secret (Settings -> API). Secret.
SUPABASE_JWT_SECRET=

# --- Frontend (Vite; read at build time, must start with VITE_) ------------------------------
# API base URL; empty = same origin (the Vite dev server proxies /api to localhost:8000).
VITE_API_BASE=
# Supabase project URL and public anon key (only when RADAR_AUTH_REQUIRED=true in the cloud).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
