# Radar environment. Copy to `.env` (gitignored) and fill in what you need.
# Local demo mode (`make dev`) needs NONE of these: it uses SQLite + the fake LLM.

# --- Database -------------------------------------------------------------------------------
# Default: local SQLite in data/radar.db. Optional (untested in production): a Postgres URL,
# e.g. postgresql://USER:PASSWORD@HOST:5432/postgres (see docs/RUNNING.md). Port 6543
# (transaction pooler) is handled. Leave commented to use the default.
# RADAR_DATABASE_URL=sqlite:///data/radar.db

# --- LLM ------------------------------------------------------------------------------------
# Provider for scoring: groq (free tier) | anthropic | fake (offline, deterministic, for demo/tests)
RADAR_LLM_PROVIDER=groq
# Model used to score postings (fast and cheap).
RADAR_SCORING_MODEL=openai/gpt-oss-20b
# Provider for application packs and outreach drafts; commented out = same as RADAR_LLM_PROVIDER.
# To write drafts with Anthropic: RADAR_DRAFT_PROVIDER=anthropic, RADAR_DRAFT_MODEL=claude-sonnet-5-5
# and ANTHROPIC_API_KEY.
# RADAR_DRAFT_PROVIDER=anthropic
# Model used to write packs and drafts (larger, better writing).
RADAR_DRAFT_MODEL=openai/gpt-oss-120b
# Secrets: never commit real values.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Collection -----------------------------------------------------------------------------
# Honest user agent sent to job boards (identify the tool and a contact URL).
RADAR_USER_AGENT=speculor-radar/0.1 (personal job-search tool; +https://github.com/DanieleGiovanardi2408/speculor)
# How long fetched pages/API responses are cached on disk (hours).
RADAR_HTTP_CACHE_TTL_HOURS=12

# --- Email alerts (optional, read-only IMAP) -------------------------------------------------
# Reads ONE Gmail label that holds LinkedIn / JobTeaser job-alert emails. Source "email" is
# enabled only when HOST, USER and PASSWORD are all set. Use a Gmail app password, never your
# main one. Radar opens the label read-only (EXAMINE, BODY.PEEK) and never marks, moves, flags or
# deletes messages; other senders are ignored and email content is never logged.
# Host for Gmail: imap.gmail.com
RADAR_IMAP_HOST=
# IMAP over SSL port (default 993). Leave commented to use the default.
# RADAR_IMAP_PORT=993
RADAR_IMAP_USER=
# Secret: a Gmail app password.
RADAR_IMAP_PASSWORD=
# Gmail label to read (a Gmail filter files the alerts there). Default: radar.
# RADAR_IMAP_FOLDER=radar
# How many days back to look for alert emails (default 14).
# RADAR_IMAP_SINCE_DAYS=14

# --- Local sending (`radar send`, never in CI) ----------------------------------------------
# Path or name of the linkedin-cli binary (mayai-linkedin-cli).
RADAR_LINKEDIN_BIN=linkedin

# --- API ------------------------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
RADAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional (self-hosting only; keep false locally): require a Supabase access token for every
# route except /api/health. See docs/RUNNING.md.
RADAR_AUTH_REQUIRED=false
# The single email address allowed to use the app when auth is required.
RADAR_ALLOWED_EMAIL=
# Supabase project URL: tokens are verified with its JWKS (ES256 / RS256).
# SUPABASE_URL=https://<project>.supabase.co
# Legacy HS256 tokens only: the Supabase project JWT secret. Secret.
SUPABASE_JWT_SECRET=

# --- Frontend (Vite; read at build time, must start with VITE_) ------------------------------
# API base URL; empty = same origin (the Vite dev server proxies /api to localhost:8000).
VITE_API_BASE=
# Supabase project URL and public anon key: reserved for a client with a login screen; the
# bundled web app does not read them (it has no login).
